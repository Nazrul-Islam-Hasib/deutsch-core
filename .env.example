# Copy to .env (git-ignored) before running `docker compose up`.
# Local development values only. Never put real secrets here.

POSTGRES_USER=deutsch
POSTGRES_PASSWORD=deutsch_dev_password
POSTGRES_DB=deutsch_core

# Any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=dev-only-change-me

# Browser origin(s) allowed by the backend's CORS check (comma-separated).
# The compose frontend is served on http://localhost:8080.
ALLOWED_ORIGINS=http://localhost:8080
